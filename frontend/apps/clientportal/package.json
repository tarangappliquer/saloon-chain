{
  "name": "clientportal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:prod": "tsc -b && vite build --mode production",
    "lint": "oxlint",
    "preview": "vite preview",
    "e2e": "node ../../scripts/run-e2e.cjs --url http://localhost:58569 --exec 'cypress run'",
    "e2e:headed": "node ../../scripts/run-e2e.cjs --url http://localhost:58569 --exec 'cypress run --headed'",
    "e2e:open": "node ../../scripts/run-e2e.cjs --url http://localhost:58569 --exec 'cypress open'"
  },
  "dependencies": {
    "@saloon/api-client": "workspace:*",
    "@saloon/ui": "workspace:*",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.1",
    "@tailwindcss/vite": "^4.3.3",
    "@uppy/core": "^4.4.1",
    "@uppy/dashboard": "^4.1.2",
    "@uppy/drag-drop": "^4.1.2",
    "@uppy/file-input": "^4.1.2",
    "@uppy/image-editor": "^4.1.2",
    "@uppy/progress-bar": "^4.1.2",
    "@uppy/react": "^4.2.1",
    "@uppy/status-bar": "^4.1.2",
    "@uppy/tus": "^4.1.2",
    "axios": "^1.19.0",
    "lucide-react": "^0.475.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "react-select": "^5.10.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}