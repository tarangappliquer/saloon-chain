{
	"files.exclude": {
		"**/.git": true,
		"**/.svn": true,
		"**/.hg": true,
		"**/.DS_Store": true,
		"**/Thumbs.db": true
	},
	"hide-files.files": [],
	"files.associations": {
		"*.json": "jsonc"
	},
	"[csharp]": {
		"editor.maxTokenizationLineLength": 2500,
		"editor.formatOnPaste": true,
		"editor.formatOnType": true,
		"editor.defaultFormatter": "ms-dotnettools.csharp"
	},
	"dotnet.defaultSolution": "backend/SaloonChains.slnx",
	"git.autofetch": true,
	"tailwindCSS.experimental.configFile": "./frontend/packages/ui/src/styles/globals.css"
}