@inherits RazorEngineCore.RazorEngineTemplateBase

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Unhandled Error Alert</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #1f2937;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color: #f3f4f6; padding: 30px 15px;">
        <tr>
            <td align="center">
                <table role="presentation" width="100%" style="max-width: 680px; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05); border: 1px solid #e5e7eb;">
                    <!-- Header -->
                    <tr>
                        <td style="background: linear-gradient(135deg, #7f1d1d 0%, #991b1b 100%); padding: 25px 30px; text-align: left;">
                            <span style="color: #fca5a5; font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; display: block; margin-bottom: 4px;">SYSTEM ALERT</span>
                            <h1 style="color: #ffffff; font-size: 22px; font-weight: 700; margin: 0;">🚨 Unexpected API Error</h1>
                        </td>
                    </tr>
                    <!-- Body -->
                    <tr>
                        <td style="padding: 30px;">
                            <div style="background-color: #fef2f2; border-left: 4px solid #dc2626; padding: 14px 18px; border-radius: 6px; margin-bottom: 24px;">
                                <p style="margin: 0; color: #991b1b; font-size: 14px; font-weight: 600;">
                                    An unhandled 500 error occurred in context: <strong>@Model.ContextName</strong>
                                </p>
                            </div>

                            <table role="presentation" width="100%" style="margin-bottom: 24px; font-size: 14px;">
                                <tr>
                                    <td style="padding: 6px 0; color: #6b7280; width: 120px; font-weight: 600;">Timestamp:</td>
                                    <td style="padding: 6px 0; color: #111827; font-family: monospace;">@Model.Timestamp</td>
                                </tr>
                                @if (!string.IsNullOrEmpty(Model.FullUrl))
                                {
                                    <tr>
                                        <td style="padding: 6px 0; color: #6b7280; font-weight: 600;">Method & Path:</td>
                                        <td style="padding: 6px 0; color: #111827;"><strong>@Model.Method</strong> @Model.Path</td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 6px 0; color: #6b7280; font-weight: 600;">Full URL:</td>
                                        <td style="padding: 6px 0; color: #2563eb; word-break: break-all;"><a href="@Model.FullUrl" style="color: #2563eb; text-decoration: underline;">@Model.FullUrl</a></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 6px 0; color: #6b7280; font-weight: 600;">Trace ID:</td>
                                        <td style="padding: 6px 0; color: #111827; font-family: monospace;">@Model.TraceId</td>
                                    </tr>
                                }
                            </table>

                            @if (!string.IsNullOrEmpty(Model.FullUrl))
                            {
                                <h3 style="font-size: 14px; font-weight: 700; color: #374151; margin: 20px 0 8px 0; text-transform: uppercase; letter-spacing: 0.5px;">Query Parameters</h3>
                                <pre style="background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px; padding: 12px; font-size: 12px; font-family: 'Courier New', Courier, monospace; color: #374151; overflow-x: auto; margin: 0 0 20px 0;">@Model.QueryParams</pre>

                                <h3 style="font-size: 14px; font-weight: 700; color: #374151; margin: 20px 0 8px 0; text-transform: uppercase; letter-spacing: 0.5px;">Request Body (Redacted)</h3>
                                <pre style="background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px; padding: 12px; font-size: 12px; font-family: 'Courier New', Courier, monospace; color: #374151; overflow-x: auto; margin: 0 0 20px 0;">@Model.RequestBody</pre>
                            }

                            <h3 style="font-size: 14px; font-weight: 700; color: #991b1b; margin: 20px 0 8px 0; text-transform: uppercase; letter-spacing: 0.5px;">Exception Details & Stack Trace</h3>
                            <pre style="background-color: #fff5f5; border: 1px solid #fed7d7; border-radius: 6px; padding: 14px; font-size: 12px; font-family: 'Courier New', Courier, monospace; color: #9b2c2c; overflow-x: auto; margin: 0; line-height: 1.5;">@Model.ExceptionDetails</pre>
                        </td>
                    </tr>
                    <!-- Footer -->
                    <tr>
                        <td style="background-color: #f9fafb; padding: 20px 30px; border-top: 1px solid #e5e7eb; text-align: center; font-size: 12px; color: #9ca3af;">
                            Saloon Chains Automated Developer Diagnostics &bull; Internal System Notification
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
