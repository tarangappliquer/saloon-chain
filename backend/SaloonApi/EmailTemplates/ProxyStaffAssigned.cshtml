@inherits RazorEngineCore.RazorEngineTemplateBase

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Proxy Staff Assigned</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f8fafc; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #1f2937;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color: #f8fafc; padding: 40px 15px;">
        <tr>
            <td align="center">
                <table role="presentation" width="100%" style="max-width: 600px; background-color: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 10px 30px rgba(79, 70, 229, 0.08); border: 1px solid #e0e7ff;">
                    <!-- Header -->
                    <tr>
                        <td style="background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%); padding: 30px 36px; text-align: left;">
                            <span style="color: #c7d2fe; font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; display: block; margin-bottom: 4px;">MANAGEMENT NOTICE</span>
                            <h1 style="color: #ffffff; font-size: 22px; font-weight: 700; margin: 0;">ℹ️ Proxy Staff Re-Assigned</h1>
                        </td>
                    </tr>
                    <!-- Body -->
                    <tr>
                        <td style="padding: 36px;">
                            <p style="font-size: 16px; font-weight: 600; color: #1f2937; margin: 0 0 16px 0;">Hello @Model.ManagerName,</p>

                            <p style="font-size: 15px; color: #4b5563; line-height: 1.6; margin: 0 0 24px 0;">
                                A proxy staff member (<strong>@Model.ProxyTherapistName</strong>) has been successfully assigned to Booking #@Model.BookingId.
                            </p>

                            <table role="presentation" width="100%" style="background-color: #f5f3ff; border-radius: 12px; padding: 20px; font-size: 14px; margin-bottom: 24px; border: 1px solid #ede9fe;">
                                <tr>
                                    <td style="padding: 6px 0; color: #6b7280; font-weight: 600; width: 140px;">Booking Ref:</td>
                                    <td style="padding: 6px 0; color: #4c1d95; font-weight: 700;">#@Model.BookingId</td>
                                </tr>
                                <tr>
                                    <td style="padding: 6px 0; color: #6b7280; font-weight: 600;">Treatment:</td>
                                    <td style="padding: 6px 0; color: #111827;">@Model.TreatmentName</td>
                                </tr>
                                <tr>
                                    <td style="padding: 6px 0; color: #6b7280; font-weight: 600;">Location:</td>
                                    <td style="padding: 6px 0; color: #111827;">@Model.LocationName</td>
                                </tr>
                                <tr>
                                    <td style="padding: 6px 0; color: #6b7280; font-weight: 600;">Proxy Staff:</td>
                                    <td style="padding: 6px 0; color: #047857; font-weight: 700;">@Model.ProxyTherapistName</td>
                                </tr>
                                <tr>
                                    <td style="padding: 6px 0; color: #6b7280; font-weight: 600;">Original Staff:</td>
                                    <td style="padding: 6px 0; color: #6b7280;">@(Model.OriginalTherapistName ?? "Unassigned")</td>
                                </tr>
                                <tr>
                                    <td style="padding: 6px 0; color: #6b7280; font-weight: 600;">Customer:</td>
                                    <td style="padding: 6px 0; color: #111827;">@Model.CustomerName</td>
                                </tr>
                                <tr>
                                    <td style="padding: 6px 0; color: #6b7280; font-weight: 600;">Time Window:</td>
                                    <td style="padding: 6px 0; color: #111827;">@Model.TimeRangeFormatted</td>
                                </tr>
                                <tr>
                                    <td style="padding: 6px 0; color: #6b7280; font-weight: 600;">Assigned By:</td>
                                    <td style="padding: 6px 0; color: #6b7280;">@Model.AssignedBy</td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <!-- Footer -->
                    <tr>
                        <td style="background-color: #f9fafb; padding: 20px 36px; border-top: 1px solid #f3f4f6; text-align: center; font-size: 12px; color: #9ca3af;">
                            Saloon Chains Operations &bull; Staff Scheduling Service
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
