# =========================================================================
# SALOON CHAINS DOCKER ENVIRONMENT CONFIGURATION
# =========================================================================

# -------------------------------------------------------------------------
# DOCKER HUB REGISTRY USERNAME
# -------------------------------------------------------------------------
DOCKERHUB_USERNAME=tarangappliquer1606

# -------------------------------------------------------------------------
# PHYSICAL HOST FOLDERS FOR PERSISTENT DATA
# -------------------------------------------------------------------------
UPLOADS_DIR=./uploads
REDIS_DATA_DIR=./docker-data/redis
POSTGRES_DATA_DIR=./docker-data/postgres

# -------------------------------------------------------------------------
# DATABASE CONNECTION STRING (Optional: Override default in-container PostgreSQL)
# -------------------------------------------------------------------------
# Default (In-Container PostgreSQL): Un-comment to explicitly set or leave commented out
# SALOON_DB_CONN_STRING=Host=saloonchains-postgres;Database=SaloonChainDb;Username=postgres;Password=SaloonChains_Dev123!;

# Option A: Host PC PostgreSQL (Running locally on Windows/Mac host machine)
# SALOON_DB_CONN_STRING=Host=host.docker.internal;Port=5432;Database=SaloonChainDb;Username=postgres;Password=YourPassword123!;

# Option B: Remote PostgreSQL (Dedicated remote database server)
# SALOON_DB_CONN_STRING=Host=192.168.1.100;Port=5432;Database=SaloonChainDb;Username=db_user;Password=db_password;

# -------------------------------------------------------------------------
# SECURITY CONFIGURATION
# -------------------------------------------------------------------------
JWT_SIGNING_KEY=SaloonChains_Production_Or_Dev_Secret_Signing_Key_32_Bytes_Min
