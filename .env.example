# =========================================================================
# SALOON CHAINS DOCKER ENVIRONMENT CONFIGURATION
# =========================================================================

# -------------------------------------------------------------------------
# DOCKER HUB REGISTRY USERNAME
# -------------------------------------------------------------------------
DOCKERHUB_USERNAME=tarangappliquer1606

# -------------------------------------------------------------------------
# PHYSICAL HOST FOLDERS FOR PERSISTENT DATA
# -------------------------------------------------------------------------
UPLOADS_DIR=./uploads
REDIS_DATA_DIR=./docker-data/redis
SQL_DATA_DIR=./docker-data/mssql

# -------------------------------------------------------------------------
# DATABASE CONNECTION STRING (Targeting Host PC or Remote SQL Server)
# -------------------------------------------------------------------------
# Option A: Host PC SQL Server (Running locally on Windows/Mac host machine)
SALOON_DB_CONN_STRING=Server=host.docker.internal,1433;Database=SaloonChainsDb;User Id=sa;Password=YourPassword123!;TrustServerCertificate=True;

# Option B: Remote SQL Server (Dedicated remote database server)
# SALOON_DB_CONN_STRING=Server=192.168.1.100,1433;Database=SaloonChainsDb;User Id=db_user;Password=db_password;TrustServerCertificate=True;

# Option C: Custom SQL Server Instance (Named instance or custom port)
# SALOON_DB_CONN_STRING=Server=host.docker.internal,1434;Database=SaloonChainsDb;User Id=sa;Password=YourPassword123!;TrustServerCertificate=True;

# -------------------------------------------------------------------------
# SECURITY CONFIGURATION
# -------------------------------------------------------------------------
JWT_SIGNING_KEY=SaloonChains_Production_Or_Dev_Secret_Signing_Key_32_Bytes_Min
