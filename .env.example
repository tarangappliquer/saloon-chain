# =========================================================================
# SALOON CHAINS DOCKER ENVIRONMENT CONFIGURATION
# =========================================================================

# -------------------------------------------------------------------------
# DOCKER HUB REGISTRY USERNAME
# -------------------------------------------------------------------------
DOCKERHUB_USERNAME=tarangappliquer1606

# -------------------------------------------------------------------------
# PHYSICAL HOST FOLDERS FOR PERSISTENT DATA
# -------------------------------------------------------------------------
UPLOADS_DIR=./uploads
REDIS_DATA_DIR=./docker-data/redis

# -------------------------------------------------------------------------
# DATABASE CONNECTION STRING (IP-bound Remote / Host PostgreSQL)
# -------------------------------------------------------------------------
# Option A: Full Connection String (Targeting Remote IP-bound PostgreSQL)
# For non-SSL remote Postgres: use Ssl Mode=Prefer or Ssl Mode=Disable
# SALOON_DB_CONN_STRING=Host=198.245.65.114;Port=5432;Database=SaloonChainDb;Username=postgres;Password=YourPassword123!;Ssl Mode=Prefer;Trust Server Certificate=true;

# Option B: Individual Remote IP Host Parameters
# POSTGRES_HOST=198.245.65.114
# POSTGRES_PORT=5432
# POSTGRES_DB=SaloonChainDb
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=YourPassword123!
# POSTGRES_SSL_MODE=Prefer

# -------------------------------------------------------------------------
# SECURITY CONFIGURATION
# -------------------------------------------------------------------------
JWT_SIGNING_KEY=SaloonChains_Production_Or_Dev_Secret_Signing_Key_32_Bytes_Min

# -------------------------------------------------------------------------
# BACKEND LOGGING CONFIGURATION
# -------------------------------------------------------------------------
# Delete existing *.json/*.jsonl log files on startup
BACKEND_CLEAN_LOGS_ON_STARTUP=false
# Also write logs to stdout/console (files are always written)
BACKEND_CONSOLE_LOGS=false

# -------------------------------------------------------------------------
# BACKEND CORS ALLOWED ORIGINS + PORTAL URLS
# -------------------------------------------------------------------------
# Comma-separated; add as many origins as you need
BACKEND_CORS_ORIGINS=http://198.245.65.114:5173,http://198.245.65.114:5174,http://localhost:8080,http://localhost:8081
BACKEND_PORTALS_ADMIN_URL=http://198.245.65.114:5173
BACKEND_PORTALS_CLIENT_URL=http://198.245.65.114:5174

# -------------------------------------------------------------------------
# BACKEND EMAIL CONFIGURATION
# -------------------------------------------------------------------------
BACKEND_EMAIL_SMTP_HOST=smtp.gmail.com
BACKEND_EMAIL_SMTP_PORT=465
BACKEND_EMAIL_USERNAME=tarangkalaria55@gmail.com
BACKEND_EMAIL_PASSWORD=
BACKEND_EMAIL_USE_SSL=true
BACKEND_EMAIL_FROM_ADDRESS=tarangkalaria55@gmail.com
BACKEND_EMAIL_FROM_NAME=Saloon Chains
BACKEND_EMAIL_DEVELOPER_EMAIL=tarangkalaria55@gmail.com

# -------------------------------------------------------------------------
# BACKEND STRIPE PAYMENT CONFIGURATION
# -------------------------------------------------------------------------
BACKEND_STRIPE_PUBLISHABLE_KEY=pk_test_sample
BACKEND_STRIPE_SECRET_KEY=
BACKEND_STRIPE_WEBHOOK_SECRET=

# -------------------------------------------------------------------------
# BACKEND FILE STORAGE CONFIGURATION
# -------------------------------------------------------------------------
BACKEND_STORAGE_PROVIDER=Local
BACKEND_STORAGE_BASE_PATH=uploads
BACKEND_STORAGE_S3_BUCKET_NAME=
BACKEND_STORAGE_S3_ACCESS_KEY=
BACKEND_STORAGE_S3_SECRET_KEY=
BACKEND_STORAGE_S3_REGION=us-east-1
BACKEND_STORAGE_S3_SERVICE_URL=
BACKEND_STORAGE_S3_PUBLIC_URL_PREFIX=

# -------------------------------------------------------------------------
# BACKEND AUTHENTICATION CONFIGURATION
# -------------------------------------------------------------------------
BACKEND_AUTH_REQUIRE_EMAIL_VERIFICATION=true
BACKEND_AUTH_SET_PASSWORD_EXPIRY_HOURS=72
BACKEND_AUTH_FORGOT_PASSWORD_EXPIRY_HOURS=1
BACKEND_AUTH_EMAIL_CHANGE_EXPIRY_HOURS=24

# -------------------------------------------------------------------------
# FRONTEND ADMIN PORTAL BUILD CONFIGURATION
# -------------------------------------------------------------------------
FRONTEND_ADMIN_VITE_API_BASE_URL=http://198.245.65.114:5127
FRONTEND_ADMIN_VITE_ENABLE_THEME_TOGGLE=false
FRONTEND_ADMIN_VITE_CLIENT_PORTAL_URL=http://198.245.65.114:5174

# -------------------------------------------------------------------------
# FRONTEND CUSTOMER PORTAL BUILD CONFIGURATION
# -------------------------------------------------------------------------
FRONTEND_CUSTOMER_VITE_API_BASE_URL=http://198.245.65.114:5127
FRONTEND_CUSTOMER_VITE_ENABLE_THEME_TOGGLE=false
FRONTEND_CUSTOMER_VITE_ADMIN_PORTAL_URL=http://198.245.65.114:5173
